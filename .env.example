# Copy this file to .env.local and fill in your own Supabase project's values.
# Only the anon/public key belongs here — never the service_role key
# (see supabase/schema.sql and README for why: it's the only key allowed
# to write daily_challenges / delete accounts, and must stay server-side).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
